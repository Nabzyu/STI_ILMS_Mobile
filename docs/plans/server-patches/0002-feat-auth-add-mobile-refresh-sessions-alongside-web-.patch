+-- Android app sessions: one web and one mobile session per account, and a 30-day refresh key
+-- for Student/Faculty phones. Only an HMAC of each key is stored.
+ALTER TABLE library_login_sessions
+  ADD COLUMN IF NOT EXISTS client text NOT NULL DEFAULT 'web',
+  ADD COLUMN IF NOT EXISTS refresh_token_hash text,
+  ADD COLUMN IF NOT EXISTS previous_refresh_token_hash text,
+  ADD COLUMN IF NOT EXISTS refresh_expires_at timestamptz;
+
+DO $$ BEGIN
+  ALTER TABLE library_login_sessions
+    ADD CONSTRAINT library_login_sessions_client_check CHECK (client IN ('web', 'mobile'));
+EXCEPTION WHEN duplicate_object THEN NULL; END $$;
+
+CREATE UNIQUE INDEX IF NOT EXISTS library_login_sessions_refresh_idx
+  ON library_login_sessions (refresh_token_hash) WHERE refresh_token_hash IS NOT NULL;
+CREATE INDEX IF NOT EXISTS library_login_sessions_previous_refresh_idx
+  ON library_login_sessions (previous_refresh_token_hash) WHERE previous_refresh_token_hash IS NOT NULL;
