diff --git a/apps/api/src/modules/auth/login-security.service.test.ts b/apps/api/src/modules/auth/login-security.service.test.ts
new file mode 100644
index 0000000..36865a4
--- /dev/null
+++ b/apps/api/src/modules/auth/login-security.service.test.ts
@@ -0,0 +1,157 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { createLoginSecurityService, MOBILE_REFRESH_MS } from './login-security.service.ts'
+import { HttpError } from '../../core/http-error.ts'
+
+type Row = Record<string, any>
+
+function fixture(role = 'Student') {
+  let clock = Date.now()
+  const account: Row = {
+    account_id: 1, user_id: 10, school_id: 'S-0001', role, account_status: 'Active', linked_status: 'Active',
+    email: 'student@ormoc.sti.edu.ph', full_name: 'Sample Student', auth_version: 1,
+  }
+  const sessions: Row[] = []
+  const challenges: Row[] = []
+  const execute = async (sql: string, values: any[] = []): Promise<any> => {
+    const s = sql.replace(/\s+/g, ' ').trim()
+    if (s.startsWith('SELECT a.account_id FROM accounts a')) return [[{ account_id: 1 }]]
+    if (s.startsWith('SELECT * FROM login_attempt_windows')) return [[{ failed_count: 0, locked_until: null, window_started_at: new Date(clock) }]]
+    if (s.includes('login_attempt_windows')) return [{ affectedRows: 1 }]
+    if (s.startsWith('SELECT auth_version FROM accounts')) return [[{ auth_version: account.auth_version }]]
+    if (s.startsWith('SELECT sent_at,failed_count,expires_at FROM login_otp_challenges')) return [[]]
+    if (s.startsWith('INSERT INTO login_otp_challenges')) {
+      challenges.push({ challenge_id: values[0], account_id: values[1], auth_version: values[2], code_hash: values[3], expires_at: values[4], sent_at: values[5], failed_count: 0, consumed_at: null })
+      return [{ affectedRows: 1 }]
+    }
+    if (s.startsWith('SELECT account_id FROM login_otp_challenges')) return [challenges.filter(row => row.challenge_id === values[0])]
+    if (s.startsWith('SELECT * FROM login_otp_challenges')) return [challenges.filter(row => row.challenge_id === values[0])]
+    if (s.startsWith('UPDATE login_otp_challenges SET consumed_at=NOW(),code_hash=NULL WHERE challenge_id')) {
+      challenges.filter(row => row.challenge_id === values[0]).forEach(row => { row.consumed_at = new Date(clock); row.code_hash = null })
+      return [{ affectedRows: 1 }]
+    }
+    if (s.includes('login_otp_challenges')) return [{ affectedRows: 1 }]
+    if (s.includes('FROM accounts a LEFT JOIN users u') && s.includes('FOR UPDATE OF a')) return [[{ ...account }]]
+    if (s.startsWith('UPDATE accounts SET auth_version')) { account.auth_version = values[0]; return [{ affectedRows: 1 }] }
+    if (s.startsWith('UPDATE users') || s.startsWith('DELETE FROM auth_sessions')) return [{ affectedRows: 1 }]
+    if (s.startsWith('SELECT s.ended_at')) return [[]]
+    if (s.startsWith('UPDATE library_login_sessions SET revoked_at=NOW()')) {
+      // The fake applies the rule below itself, so insist the real query is scoped the same way.
+      assert.ok(s.includes('AND (client=? OR auth_version<>?)'), 'sign-in must only replace the same client\'s session')
+      const [accountId, client, version] = values
+      sessions.filter(row => row.account_id === accountId && !row.revoked_at && (row.client === client || row.auth_version !== version))
+        .forEach(row => Object.assign(row, { revoked_at: new Date(clock), refresh_token_hash: null, previous_refresh_token_hash: null }))
+      return [{ affectedRows: 1 }]
+    }
+    if (s.startsWith('INSERT INTO library_login_sessions')) {
+      const [session_id, account_id, auth_version, last_activity_at, client, refresh_token_hash, refresh_expires_at] = values
+      sessions.push({ session_id, account_id, auth_version, last_activity_at, client, refresh_token_hash, refresh_expires_at, previous_refresh_token_hash: null, revoked_at: null })
+      return [{ affectedRows: 1 }]
+    }
+    if (s.startsWith('SELECT account_id FROM library_login_sessions')) {
+      return [sessions.filter(row => row.refresh_token_hash === values[0] || row.previous_refresh_token_hash === values[1])]
+    }
+    if (s.startsWith('SELECT * FROM library_login_sessions WHERE account_id=? AND (refresh_token_hash')) {
+      return [sessions.filter(row => row.account_id === values[0] && (row.refresh_token_hash === values[1] || row.previous_refresh_token_hash === values[2]))]
+    }
+    if (s.startsWith('UPDATE library_login_sessions SET previous_refresh_token_hash=refresh_token_hash')) {
+      const row = sessions.find(item => item.session_id === values[2])!
+      Object.assign(row, { previous_refresh_token_hash: row.refresh_token_hash, refresh_token_hash: values[0], last_activity_at: values[1] })
+      return [{ affectedRows: 1 }]
+    }
+    if (s.startsWith('UPDATE library_login_sessions SET revoked_at=COALESCE')) {
+      const byKey = s.endsWith('WHERE refresh_token_hash=?')
+      sessions.filter(row => byKey ? row.refresh_token_hash === values[0] : row.session_id === values[0])
+        .forEach(row => Object.assign(row, { revoked_at: row.revoked_at ?? new Date(clock), refresh_token_hash: null, previous_refresh_token_hash: null }))
+      return [{ affectedRows: 1 }]
+    }
+    throw new Error(`Unexpected SQL in fixture: ${s}`)
+  }
+  const connection = { execute, beginTransaction: async () => undefined, commit: async () => undefined, rollback: async () => undefined, release: () => undefined }
+  const service = createLoginSecurityService(
+    { execute, getConnection: async () => connection } as never,
+    async () => ({ accountId: 1, userId: 10, schoolId: account.school_id, role: account.role, authVersion: account.auth_version, fullName: account.full_name, email: account.email }),
+    async () => undefined,
+    () => clock,
+    () => '123456',
+    () => false,
+  )
+  const live = (client: string) => sessions.filter(row => row.client === client && !row.revoked_at)
+  return { service, account, sessions, live, now: () => clock, advance: (ms: number) => { clock += ms } }
+}
+
+const code = (expected: string) => (error: unknown) => error instanceof HttpError && error.code === expected
+
+// Login results are a union (token, code challenge, device switch); tests read the fields they expect.
+async function signIn(f: ReturnType<typeof fixture>, client?: string): Promise<any> {
+  const challenge: any = await f.service.login({ school_id: f.account.school_id, password: 'pw', portal: 'user', client })
+  assert.equal(challenge.otpRequired, true)
+  return f.service.verify({ challenge_id: challenge.challengeId, code: '123456', client })
+}
+
+test('a phone and the website stay signed in together; a same-client sign-in replaces the old one', async () => {
+  const f = fixture()
+  const web = await signIn(f)
+  assert.equal(web.refreshToken, undefined)
+  const phone = await signIn(f, 'mobile')
+  assert.equal(f.live('web').length, 1)
+  assert.equal(f.live('mobile').length, 1)
+  assert.equal(f.account.auth_version, 1, 'a normal sign-in no longer bumps auth_version')
+  assert.match(phone.refreshToken, /^[A-Za-z0-9_-]{43}$/)
+  assert.equal(phone.refreshExpiresIn, MOBILE_REFRESH_MS / 1000)
+  assert.notEqual(f.live('mobile')[0].refresh_token_hash, phone.refreshToken, 'only a hash is stored')
+
+  await signIn(f, 'mobile')
+  assert.equal(f.live('mobile').length, 1, 'second phone sign-in replaces the first')
+  assert.equal(f.live('web').length, 1, 'website session survives')
+  await assert.rejects(f.service.refresh({ refresh_token: phone.refreshToken }), code('REFRESH_INVALID'))
+})
+
+test('refresh rotates the key; reusing a replaced key ends the session', async () => {
+  const f = fixture()
+  const phone = await signIn(f, 'mobile')
+  f.advance(20 * 60_000)
+  const first: any = await f.service.refresh({ refresh_token: phone.refreshToken })
+  assert.ok(first.token)
+  assert.notEqual(first.refreshToken, phone.refreshToken)
+  assert.ok(first.refreshExpiresIn < MOBILE_REFRESH_MS / 1000, 'rotation does not extend the 30 days')
+  assert.equal(f.live('mobile')[0].last_activity_at.getTime(), f.now(), 'refresh counts as activity for the 10-minute rule')
+
+  await assert.rejects(f.service.refresh({ refresh_token: phone.refreshToken }), code('REFRESH_INVALID'))
+  assert.equal(f.live('mobile').length, 0, 'stolen-key reuse revokes the session')
+  await assert.rejects(f.service.refresh({ refresh_token: first.refreshToken }), code('REFRESH_INVALID'))
+})
+
+test('refresh stops after 30 days, a password reset, deactivation or logout', async () => {
+  const expired = fixture()
+  const a = await signIn(expired, 'mobile')
+  expired.advance(MOBILE_REFRESH_MS + 1)
+  await assert.rejects(expired.service.refresh({ refresh_token: a.refreshToken }), code('REFRESH_INVALID'))
+
+  const reset = fixture()
+  const b = await signIn(reset, 'mobile')
+  reset.account.auth_version = 2
+  await assert.rejects(reset.service.refresh({ refresh_token: b.refreshToken }), code('REFRESH_INVALID'))
+
+  const deactivated = fixture()
+  const c = await signIn(deactivated, 'mobile')
+  deactivated.account.account_status = 'Deactivated'
+  await assert.rejects(deactivated.service.refresh({ refresh_token: c.refreshToken }), code('REFRESH_INVALID'))
+
+  const out = fixture()
+  const d = await signIn(out, 'mobile')
+  assert.deepEqual(await out.service.logout({ refresh_token: d.refreshToken }), { signedOut: true })
+  assert.equal(out.live('mobile').length, 0)
+  await assert.rejects(out.service.refresh({ refresh_token: d.refreshToken }), code('REFRESH_INVALID'))
+  assert.deepEqual(await out.service.logout({ refresh_token: 'not-a-key' }), { signedOut: true })
+})
+
+test('staff phones get a session but no refresh key; malformed keys are rejected', async () => {
+  const f = fixture('Librarian')
+  const result: any = await f.service.login({ school_id: f.account.school_id, password: 'pw', portal: 'staff', client: 'mobile' })
+  assert.ok(result.token)
+  assert.equal(result.refreshToken, undefined)
+  assert.equal(f.live('mobile').length, 1)
+  await assert.rejects(f.service.refresh({ refresh_token: 'short' }), code('REFRESH_INVALID'))
+  await assert.rejects(f.service.refresh({}), code('REFRESH_INVALID'))
+})
